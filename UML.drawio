        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor User\n    participant c as colony : MarsColony\n    participant eh as emergencyHandler : EmergencyHandler\n    participant ol as emergency : OxygenLeak\n    participant h as affectedHabitat : Habitat\n    participant r as resources : Resources\n    participant eng as human : Engineer\n    participant bot as robot : RepairRobot\n\n    User-&gt;&gt;c: advanceDay()\n    c-&gt;&gt;eh: handleEmergencies(c)\n    eh-&gt;&gt;c: getAllAgents()\n    c--&gt;&gt;eh: allAgents\n\n    eh-&gt;&gt;ol: happen()\n    ol-&gt;&gt;h: setOperational(false)\n\n    eh-&gt;&gt;eh: handleOxygenLeak(c, ol, allAgents)\n\n    loop find human responder\n        eh-&gt;&gt;eng: canRespond(ol), isAvailable(), isHuman()\n        eng--&gt;&gt;eh: true\n        eh-&gt;&gt;eng: setLocation(ol.location)\n    end\n\n    loop find robot responder\n        eh-&gt;&gt;bot: canRespond(ol), isAvailable(), isRobot()\n        bot--&gt;&gt;eh: true\n        eh-&gt;&gt;bot: setLocation(ol.location)\n    end\n\n    eh-&gt;&gt;c: getTotal(SPARE_PARTS)\n    c--&gt;&gt;eh: totalSpareParts\n\n    alt humanAvailable and robotAvailable and sparePartsAvailable\n        eh-&gt;&gt;c: consume(SPARE_PARTS, 1)\n        c-&gt;&gt;r: consumeAmount(SPARE_PARTS, 1)\n        eh-&gt;&gt;h: looseOxygen(10)\n        h-&gt;&gt;r: consumeAmount(OXYGEN, 10)\n        eh-&gt;&gt;ol: resolveEmergency()\n        eh-&gt;&gt;h: setOperational(true)\n    else missing responder or no spare parts\n        eh-&gt;&gt;h: looseOxygen(20)\n        h-&gt;&gt;r: consumeAmount(OXYGEN, 20)\n    end\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="JgxfZYys3mATE5ICvlzG-62">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
