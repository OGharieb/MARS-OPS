<mxfile host="app.diagrams.net" pages="5">
  <diagram id="ASj8z_KblUBOFNw4yVol" name="ClassDiagram">
    <mxGraphModel dx="5709" dy="2494" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    %% ==================== COLONY PACKAGE ====================\n    class MarsColony {\n        ~List~Facility~ facilities\n        -int currentDay\n        ~List~Mission~ missions\n        +String martianSurface$\n        -EmergencyHandler emergencyHandler\n        +List~Emergency~ emergencies\n        -EnvironmentCondition environment\n        +MarsColony()\n        +setEnvironment(EnvironmentCondition) void\n        +getEnvironment() EnvironmentCondition\n        +getFacilities() List~Facility~\n        +addFacility(Facility) void\n        +getTotal(ResourceType) int\n        +consume(ResourceType, int) boolean\n        +getAllEquipment() List~Equipment~\n        +getAllAgents() List~Agent~\n        +hasOperationalLab() boolean\n        +submitMission(Mission) void\n        +advanceDay() void\n        +getCurrentDay() int\n        +printStatusReport() void\n    }\n\n    class EmergencyHandler {\n        +handleEmergencies(MarsColony) boolean\n        -handleOxygenLeak(MarsColony, OxygenLeak, List~Agent~) boolean\n        -handleFire(MarsColony, Fire, List~Agent~) boolean\n        -handleRoverBreakdown(MarsColony, RoverBreakdown, List~Agent~) boolean\n        -handleMedicalEmergency(MarsColony, MedicalEmergency, List~Agent~) boolean\n    }\n\n    %% ==================== AGENTS PACKAGE ====================\n    class Agent {\n        &lt;&lt;interface&gt;&gt;\n        +getId() String\n        +getLocation() String\n        +setLocation(String) void\n        +isAvailable() boolean\n        +setAvailable(boolean) void\n        +canRespond(Emergency) boolean\n        +canPerform(Mission) boolean\n        +getRole() AgentRole\n        +setLocationToMartianSurface() void\n        +isRobot() boolean\n        +isHuman() boolean\n    }\n\n    class CrewMember {\n        &lt;&lt;abstract&gt;&gt;\n        #String id\n        #String name\n        #String location\n        #boolean available\n        #List~SkillType~ skills\n        #int healthStatus\n        ~AgentRole role\n        +CrewMember(String, String, String, AgentRole, List~SkillType~)\n        +getName() String\n        +getHealthStatus() int\n        +setHealthStatus(int) void\n    }\n\n    class RoboticUnit {\n        &lt;&lt;abstract&gt;&gt;\n        #String id\n        #String location\n        #boolean available\n        #int batteryLevel\n        #boolean functional\n        #AgentRole role\n        +RoboticUnit(String, String, AgentRole)\n        +repair() void\n        +recharge() void\n        +setFunctional(boolean) void\n        +isFunctional() boolean\n        +getBatteryLevel() int\n        +drainBattery(int) void\n    }\n\n    class Scientist {\n        +Scientist(String, String, String, List~SkillType~)\n        +canPerform(Mission) boolean\n        +canRespond(Emergency) boolean\n    }\n\n    class Engineer {\n        +Engineer(String, String, String, List~SkillType~)\n        +canPerform(Mission) boolean\n        +canRespond(Emergency) boolean\n    }\n\n    class MedicalOfficer {\n        +MedicalOfficer(String, String, String, List~SkillType~)\n        +canPerform(Mission) boolean\n        +canRespond(Emergency) boolean\n    }\n\n    class ExplorationRover {\n        +ExplorationMission assignedMission\n        +ExplorationRover(String, String)\n        +assignExplorationMission(ExplorationMission) void\n        +canPerform(Mission) boolean\n        +canRespond(Emergency) boolean\n    }\n\n    class RepairRobot {\n        +RepairRobot(String, String)\n        +canPerform(Mission) boolean\n        +canRespond(Emergency) boolean\n    }\n\n    class Drone {\n        +Drone(String, String)\n        +canPerform(Mission) boolean\n        +canRespond(Emergency) boolean\n    }\n\n    %% ==================== FACILITIES PACKAGE ====================\n    class Facility {\n        &lt;&lt;abstract&gt;&gt;\n        #boolean isOperational\n        #FacilityType type\n        #Resources resources\n        #List~Equipment~ equipments\n        #List~Agent~ agents\n        +String facilityName\n        +Facility(FacilityType, String)\n        +addAgent(Agent) void\n        +addEquipment(Equipment) void\n        +getAgents() List~Agent~\n        +setOperational(boolean) void\n        +isOperational() boolean\n        +getType() FacilityType\n        +getEquipment() List~Equipment~\n        +getResources() Resources\n        +medicalEmergencyOccurs(int) void\n        +looseOxygen(int) void\n    }\n\n    class Habitat {\n        -LifeSupportSystem lifeSupport\n        ~Habitat(String)\n        +isHabitable() boolean\n    }\n\n    class LifeSupportSystem {\n        -List~Agent~ agents\n        -Resources resources\n        +LifeSupportSystem(List~Agent~, Resources)\n        +isHabitable() boolean\n    }\n\n    class Laboratory {\n        ~Laboratory(String)\n        +hasScientists() int\n        +repairAllEquipments() void\n        +damageAllEquipments() void\n    }\n\n    class PowerStation {\n        ~PowerStation(String)\n        +generatePower(int) void\n    }\n\n    class StorageFacility {\n        ~StorageFacility(String)\n        +hasResource(ResourceType) boolean\n    }\n\n    class CommunicationStation {\n        ~CommunicationStation(String)\n        +sendMessage(String) void\n        +receiveMessage(String) void\n    }\n\n    %% ==================== RESOURCES &amp; EQUIPMENT ====================\n    class Resources {\n        -Map~ResourceType, Integer~ quantities\n        +Resources()\n        +getAmount(ResourceType) int\n        +addAmount(ResourceType, int) void\n        +consumeAmount(ResourceType, int) boolean\n        +consumeAll(ResourceType) void\n        +isEmpty(ResourceType) boolean\n    }\n\n    class Equipment {\n        -boolean isDamaged\n        -String id\n        -EquipmentType type\n        -boolean assigned\n        +Equipment(String, EquipmentType)\n        +getType() EquipmentType\n        +getId() String\n        +isDamaged() boolean\n        +setDamaged(boolean) void\n        +isAssigned() boolean\n        +setAssigned(boolean) void\n        +damageEquipment() void\n        +repairEquipment() void\n    }\n\n    %% ==================== MISSIONS PACKAGE ====================\n    class Mission {\n        &lt;&lt;abstract&gt;&gt;\n        #String location\n        #SkillType requiredSkill\n        #MissionType missionType\n        #int elapsedTime\n        #int duration\n        #MissionState state\n        #List~Agent~ assignedAgents\n        +Mission(String, SkillType, int, MissionType)\n        +getMissionType() MissionType\n        +assign(Agent) void\n        +getAgents() List~Agent~\n        +getRequiredSkill() SkillType\n        +getState() MissionState\n        +setState(MissionState) void\n        +advanceTime() void\n        +assignEquipment(MarsColony)* void\n        +consumeResources(MarsColony)* void\n        +assembleTeam(List~Agent~)* boolean\n        +hasSufficientRecourses(MarsColony)* boolean\n        +hasRequiredEquipment(MarsColony)* boolean\n    }\n\n    class ExplorationMission {\n        ~int requiredBatteries\n        +ExplorationMission(String, SkillType)\n    }\n\n    class RepairMission {\n        ~int requiredSpareParts\n        +RepairMission(String, SkillType)\n    }\n\n    class RescueMission {\n        ~int requiredFood\n        ~int requiredMedical\n        +RescueMission(String, SkillType)\n    }\n\n    class ResearchMission {\n        ~int requiredOxygen\n        ~int requiredBatteryPower\n        +ResearchMission(String, SkillType)\n    }\n\n    %% ==================== EMERGENCIES PACKAGE ====================\n    class Emergency {\n        &lt;&lt;abstract&gt;&gt;\n        +EmergencyType type\n        +EmergencyState state\n        +String location\n        ~Emergency(EmergencyType)\n        ~setLocation(String) void\n        ~setLocationToMartianSurface() void\n        +resolveEmergency() void\n        +happen()* void\n        +getType() EmergencyType\n        +isResolved() boolean\n        +setResolved(boolean) void\n    }\n\n    class OxygenLeak {\n        +Habitat affectedHabitat\n        -boolean hasLeaked\n        +int oxygenLeakAmount\n        +OxygenLeak(Habitat)\n        +happen() void\n    }\n\n    class Fire {\n        +Laboratory affectedLaboratory\n        ~Fire(Laboratory)\n        +happen() void\n    }\n\n    class RoverBreakdown {\n        +ExplorationRover rover\n        ~RoverBreakdown(ExplorationRover)\n        +happen() void\n    }\n\n    class MedicalEmergency {\n        +CrewMember agent\n        +MedicalEmergency(CrewMember)\n        +happen() void\n    }\n\n    %% ==================== ENUMS ====================\n    class AgentRole {\n        &lt;&lt;enumeration&gt;&gt;\n        SCIENTIST\n        ENGINEER\n        MEDICAL_OFFICER\n        DRONE\n        REPAIR_ROBOT\n        EXPLORATION_ROVER\n    }\n\n    class MissionState {\n        &lt;&lt;enumeration&gt;&gt;\n        PENDING\n        ASSIGNED\n        IN_PROGRESS\n        COMPLETED\n        FAILED\n    }\n\n    class EnvironmentCondition {\n        &lt;&lt;enumeration&gt;&gt;\n        NORMAL\n        DUST_STORM\n        COMM_DISRUPTION\n    }\n\n    class ResourceType {\n        &lt;&lt;enumeration&gt;&gt;\n        OXYGEN\n        WATER\n        FOOD\n        FUEL\n        BATTERY\n        MEDICAL_SUPPLIES\n        SPARE_PARTS\n    }\n\n    %% ==================== RELATIONSHIPS ====================\n    %% Inheritance &amp; Realization\n    Agent &lt;|.. CrewMember\n    Agent &lt;|.. RoboticUnit\n    CrewMember &lt;|-- Scientist\n    CrewMember &lt;|-- Engineer\n    CrewMember &lt;|-- MedicalOfficer\n    RoboticUnit &lt;|-- ExplorationRover\n    RoboticUnit &lt;|-- RepairRobot\n    RoboticUnit &lt;|-- Drone\n\n    Facility &lt;|-- Habitat\n    Facility &lt;|-- Laboratory\n    Facility &lt;|-- PowerStation\n    Facility &lt;|-- StorageFacility\n    Facility &lt;|-- CommunicationStation\n\n    Mission &lt;|-- ExplorationMission\n    Mission &lt;|-- RepairMission\n    Mission &lt;|-- RescueMission\n    Mission &lt;|-- ResearchMission\n\n    Emergency &lt;|-- OxygenLeak\n    Emergency &lt;|-- Fire\n    Emergency &lt;|-- RoverBreakdown\n    Emergency &lt;|-- MedicalEmergency\n\n    %% Composition (Strong Lifecycle Ownership)\n    MarsColony \&quot;1\&quot; *-- \&quot;1\&quot; EmergencyHandler : owns\n    Facility \&quot;1\&quot; *-- \&quot;1\&quot; Resources : owns\n    Habitat \&quot;1\&quot; *-- \&quot;1\&quot; LifeSupportSystem : owns\n\n    %% Aggregation (Whole-Part Independent Lifecycle)\n    MarsColony \&quot;1\&quot; o-- \&quot;*\&quot; Facility : manages\n    MarsColony \&quot;1\&quot; o-- \&quot;*\&quot; Mission : tracks\n    MarsColony \&quot;1\&quot; o-- \&quot;*\&quot; Emergency : tracks\n    Facility \&quot;1\&quot; o-- \&quot;*\&quot; Agent : houses\n    Facility \&quot;1\&quot; o-- \&quot;*\&quot; Equipment : stores\n    Mission \&quot;1\&quot; o-- \&quot;*\&quot; Agent : assigns\n\n    %% Associations\n    ExplorationRover \&quot;0..1\&quot; --&gt; \&quot;0..1\&quot; ExplorationMission : assignedMission\n    OxygenLeak \&quot;*\&quot; --&gt; \&quot;1\&quot; Habitat : affectedHabitat\n    Fire \&quot;*\&quot; --&gt; \&quot;1\&quot; Laboratory : affectedLaboratory\n    RoverBreakdown \&quot;*\&quot; --&gt; \&quot;1\&quot; ExplorationRover : rover\n    MedicalEmergency \&quot;*\&quot; --&gt; \&quot;1\&quot; CrewMember : agent\n    MarsColony --&gt; EnvironmentCondition : uses\n    Mission --&gt; MissionState : uses\n    Resources --&gt; ResourceType : maps\n    Agent --&gt; AgentRole : has\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="_e5Os0Ck5z1I7flIhWQ--1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;MarsColony&lt;/b&gt;" mermaidId="n:MarsColony" mermaidBaseStyle="swimlane;html=1;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;horizontal=1;childLayout=stackLayout;startSize=45;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginTop=12;marginBottom=12;stackSpacing=0;swimlaneFillColor=#FDF4FF;whiteSpace=wrap;fillColor=#FDF4FF;strokeColor=#E879F9;fontColor=#28253D;fontFamily=Recursive;strokeWidth=2;shadow=1;shadowColor=#000000;shadowOffsetX=4;shadowOffsetY=4;shadowBlur=0;shadowOpacity=6;" mermaidBaseValue="&lt;b&gt;MarsColony&lt;/b&gt;" id="_e5Os0Ck5z1I7flIhWQ--2">
