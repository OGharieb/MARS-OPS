        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor User\n    participant c as colony : MarsColony\n    participant m as m : ExplorationMission\n    participant a as agent : Agent\n\n    User-&gt;&gt;c: setEnvironment(DUST_STORM)\n    loop for each Mission m in missions\n        c-&gt;&gt;m: getState()\n        m--&gt;&gt;c: state\n        c-&gt;&gt;m: getMissionType()\n        m--&gt;&gt;c: EXPLORATION\n\n        opt (state == ASSIGNED or state == IN_PROGRESS) and type == EXPLORATION\n            c-&gt;&gt;m: setState(FAILED)\n            loop for each agent in assignedAgents\n                m-&gt;&gt;a: setAvailable(true)\n            end\n        end\n    end\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="JgxfZYys3mATE5ICvlzG-103">
