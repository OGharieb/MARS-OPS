        <mxCell id="_e5Os0Ck5z1I7flIhWQ--19" parent="_e5Os0Ck5z1I7flIhWQ--2" style="text;fontSize=14;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=12;spacingBottom=2;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Recursive;fontColor=#28253D;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DRecursive;" value="+getAllAgents() List&lt;Agent&gt;" vertex="1">
