  <diagram id="x57sdQoKS-XuFLjf8kxm" name="Sequence">
    <mxGraphModel dx="5709" dy="2494" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    actor User\n    participant c as colony : MarsColony\n    participant m as mission : ExplorationMission\n    participant f as facility : Facility\n    participant r as resources : Resources\n    participant eq as eq : Equipment\n    participant a as agent : Agent\n\n    User-&gt;&gt;c: submitMission(m)\n    c-&gt;&gt;m: hasRequiredEquipment(c)\n    m-&gt;&gt;c: getAllEquipment()\n    c-&gt;&gt;f: getEquipment()\n    f--&gt;&gt;c: equipments\n    m-&gt;&gt;eq: getType(), isDamaged(), isAssigned()\n    eq--&gt;&gt;m: EXPLORATION, false, false\n    m--&gt;&gt;c: true\n\n    c-&gt;&gt;m: hasSufficientRecourses(c)\n    m-&gt;&gt;c: getTotal(BATTERY)\n    c-&gt;&gt;f: getResources().getAmount(BATTERY)\n    f--&gt;&gt;c: amount\n    m--&gt;&gt;c: true\n\n    alt equipment == false or resources == false\n        c-&gt;&gt;m: setState(FAILED)\n    else equipment == true and resources == true\n        c-&gt;&gt;c: getAllAgents()\n        c-&gt;&gt;m: assembleTeam(allAgents)\n        loop for each Agent in allAgents\n            m-&gt;&gt;a: canPerform(m)\n            a--&gt;&gt;m: boolean\n            m-&gt;&gt;a: getRole()\n            a--&gt;&gt;m: role\n        end\n        alt team assembled\n            m-&gt;&gt;m: assign(a)\n            m--&gt;&gt;c: true\n            c-&gt;&gt;m: consumeResources(c)\n            m-&gt;&gt;c: consume(BATTERY, 20)\n            c-&gt;&gt;r: consumeAmount(BATTERY, 20)\n            c-&gt;&gt;m: assignEquipment(c)\n            m-&gt;&gt;eq: setAssigned(true)\n            c-&gt;&gt;m: setState(ASSIGNED)\n        else team not assembled\n            m--&gt;&gt;c: false\n            c-&gt;&gt;m: setState(FAILED)\n        end\n    end\n\n    loop each day while IN_PROGRESS\n        User-&gt;&gt;c: advanceDay()\n        c-&gt;&gt;m: advanceTime()\n        opt elapsedTime &gt;= duration\n            m-&gt;&gt;m: setState(COMPLETED)\n            loop for each assignedAgent\n                m-&gt;&gt;a: setAvailable(true)\n            end\n        end\n    end\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="JgxfZYys3mATE5ICvlzG-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
